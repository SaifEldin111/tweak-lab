{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{protected_product/**,seed_orders.json,seed_deleted_orders.json}"
    }
  },
  "headers": [
    {
      "source": "/TweakLab_Free_Lite.bat",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"TweakLab_Free_Lite.bat\"" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" }
  ]
}
